---
interface Props {
    pub: any;
}
const { pub } = Astro.props;
const TYPE_TINT: Record<string, string> = { phdthesis: '--c-ochre', article: '--c-teal', inproceedings: '--c-coral' };
---

<div class="ledger-row" style="grid-template-columns: 56px 1fr;">
    <!-- Year -->
    <span
        class={`font-mono text-[12px] tracking-[0.1em] ${String(pub.year) === '2026' ? 'text-tealDeep' : 'opacity-70'}`}
        style="font-variant-numeric: tabular-nums;"
    >
        {pub.year}
    </span>

    <!-- Title + meta -->
    <div>
        {(pub.url || pub.doi) ? (
            <a
                href={pub.url || `https://doi.org/${pub.doi}`}
                target="_blank"
                rel="noopener"
                class="font-display font-medium block leading-[1] pub-row-marker
                       text-ink hover:text-interactive transition-colors no-underline"
                style={`font-size: 18px; letter-spacing: -0.2px; --marker: rgb(var(${TYPE_TINT[pub.type] ?? '--c-teal'}) / 0.35);`}
            >
                {pub.title} <span class="font-mono text-[9px] opacity-50 align-top">↗</span>
            </a>
        ) : (
            <span
                class="font-display font-medium block leading-[1] pub-row-marker"
                style={`font-size: 18px; letter-spacing: -0.2px; --marker: rgb(var(${TYPE_TINT[pub.type] ?? '--c-teal'}) / 0.35);`}
            >
                {pub.title}
            </span>
        )}
        <span class="font-mono text-[10px] tracking-[0.1em] opacity-70 mt-[4px] block">
            {[pub.authors, pub.type === 'phdthesis' ? 'Ph.D. dissertation' : pub.venue].filter(Boolean).join(' · ')}
        </span>
    </div>
</div>
