---
// Publications ledger — reads from public/data/publications.json generated at build.
// Designed to be rendered in a <slot name="publications"> inside About.astro.
import PublicationRow from './PublicationRow.astro';
let pubs: any[] = [];
try {
    const raw = await import('../../public/data/publications.json');
    pubs = (raw.default ?? []).sort((a: any, b: any) => b.year - a.year);
} catch {
    // JSON not yet generated — populated on first build
}
---

<section id="publications" class="px-page pt-[48px] pb-[48px]">
    <div class="flex items-baseline justify-between mb-[24px]">
        <h2
            class="font-display font-normal text-ink m-0"
            style="font-size: 32px; letter-spacing: -0.4px;"
        >
            <em>Publications,</em> selected.
        </h2>
        <span class="kicker">§ 03 / 05</span>
    </div>

    {pubs.length === 0 ? (
        <p class="font-mono text-[12px] opacity-60">
            Run <code>npm run build</code> to generate publications from .bib
        </p>
    ) : (
        <div>
            {pubs.slice(0, 2).map((pub: any) => <PublicationRow pub={pub} />)}
            {pubs.length > 2 && (
                <details class="ledger-more">
                    <summary>View all {pubs.length} publications</summary>
                    <div class="pt-[6px]">
                        {pubs.slice(2).map((pub: any) => <PublicationRow pub={pub} />)}
                    </div>
                </details>
            )}
        </div>
    )}
</section>
