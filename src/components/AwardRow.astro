---
interface Props {
    a: { year: string; title: string };
}
const { a } = Astro.props;
---

<div class="ledger-row" style="grid-template-columns: 56px 1fr;">
    <span class="font-mono text-[12px] tracking-[0.1em] opacity-70"
          style="font-variant-numeric: tabular-nums;">{a.year}</span>
    <span class="font-display font-medium block leading-[1]"
          style="font-size: 18px; letter-spacing: -0.2px;">{a.title}</span>
</div>
