---
// About — all sections of the landing page live here.
// recentProjects is passed from index.astro (3 most-recent entries).
import { bio, education, awards, experience, talks } from '../data/about';
import AwardRow from './AwardRow.astro';

interface RecentProject {
    slug: string;
    title: string;
    summary: string;
    category: string;
    date: string;
    status: string;
}

interface Props {
    recentProjects?: RecentProject[];
}

const { recentProjects = [] } = Astro.props;

// Category-keyed accent tint for project swatches (theme-aware via RGB-channel tokens).
const CATEGORY_TINT: Record<string, string> = {
    work:     '--c-ochre',
    academic: '--c-teal',
    personal: '--c-sage',
};
const STATUS_SYMBOL: Record<string, string> = {
    complete: '●',
    ongoing:  '◐',
    archived: '○',
};
---

<!-- ── § Masthead + Bio (shared mountain texture) ─────────── -->
<div
    class="relative"
    style="background-image: url('/assets/img/mountain.jpg'); background-size: cover; background-position: center 40%;"
>
    <!-- Theme-aware overlay: washes photo to a barely-there texture -->
    <div class="absolute inset-0 pointer-events-none" style="background: var(--color-masthead-overlay);"></div>

    <!-- Masthead -->
    <section class="px-page pt-[56px] pb-0 relative z-10">
        <p class="kicker mb-[14px]">— About · Updated 2026·04</p>
        <h1
            class="font-display font-normal leading-[0.95] tracking-tight text-ink max-w-[1000px]"
            style="font-size: clamp(56px, 8.6vw, 104px); letter-spacing: clamp(-1.4px, -0.18vw, -2.4px);"
        >
            Researcher, <em>tinkerer,</em><br />
            and <em class="text-teal">worldbuilder.</em>
        </h1>
    </section>

    <!-- Bio + Portrait -->
    <section class="px-page pt-[40px] pb-[36px] relative z-10">
    <div
        id="portrait-wrap"
        class="grid gap-[24px] md:gap-[56px]
               grid-cols-1
               md:[grid-template-columns:minmax(220px,300px)_minmax(0,1fr)]"
    >
        <!-- Portrait -->
        <div class="w-[160px] md:w-full" role="group" aria-label="Portrait of Yu-Chin Chan, Grandfather Mountain">
            <div
                class="relative overflow-hidden"
                style="aspect-ratio: 4/5; box-shadow: 0 1px 0 var(--color-ink), 0 18px 40px -24px rgba(0,0,0,0.35);"
            >
                <img
                    src="/assets/img/portrait.jpg"
                    alt="Yu-Chin Chan"
                    class="w-full h-full object-cover"
                    style="filter: saturate(0.92) contrast(1.02);"
                />
                <!-- Registration mark -->
                <span
                    aria-hidden="true"
                    class="absolute top-[8px] left-[8px] font-mono text-[9px]
                           tracking-[0.15em] text-white/75 pointer-events-none"
                >
                    + PL.01
                </span>
            </div>
            <!-- Caption -->
            <div class="flex flex-col gap-[2px] md:flex-row md:justify-between mt-2 overflow-hidden" aria-hidden="true">
                <span class="font-mono text-[10px] tracking-[0.12em] uppercase opacity-70 truncate">
                    Fig. 1 — Y.C.
                </span>
                <span class="font-mono text-[10px] tracking-[0.12em] uppercase opacity-70 truncate">
                    @ Grandfather Mtn.
                </span>
            </div>
        </div>

        <!-- Bio -->
        <div id="bio-reveal" class="flex flex-col justify-center gap-5">
            <!-- Italic lead -->
            {bio.length > 0 && (
                <p
                    class="font-display italic leading-[1.35] text-ink/88 max-w-[680px]"
                    style="font-size: 24px;"
                >
                    {bio[0].split(/\*(.*?)\*/).map((seg, i) =>
                        i % 2 === 1 ? <em class="text-teal">{seg}</em> : seg
                    )}
                </p>
            )}
            <!-- Body paragraphs -->
            {bio.slice(1).map(para => (
                <p class="font-body text-[16px] leading-[1.65] text-ink/82 max-w-[620px]">
                    {para}
                </p>
            ))}

            <!-- Contact links -->
            <div class="flex flex-wrap gap-x-7 gap-y-3 mt-[8px]">
                <span class="font-mono text-[11px] tracking-[0.05em]">
                    <span class="opacity-70 mr-2">Email</span>
                    <a
                        id="contact-email"
                        href="mailto:lychan115&#64;gmail.com"
                        data-u="lychan115"
                        data-d="gmail.com"
                        class="border-b border-teal pb-[2px] text-ink hover:text-interactive
                               transition-colors no-underline"
                    >lychan115&#64;gmail.com</a>
                </span>
                <span class="font-mono text-[11px] tracking-[0.05em]">
                    <span class="opacity-70 mr-2">GitHub</span>
                    <a
                        href="https://github.com/lychan110"
                        target="_blank" rel="noopener"
                        class="border-b border-teal pb-[2px] text-ink hover:text-interactive
                               transition-colors no-underline"
                    >
                        lychan110 <span class="font-mono text-[9px] opacity-60 align-top" aria-hidden="true">↗</span>
                    </a>
                </span>
                <span class="font-mono text-[11px] tracking-[0.05em]">
                    <span class="opacity-70 mr-2">Scholar</span>
                    <a
                        href="https://scholar.google.com/citations?user=ZK2gpWYAAAAJ"
                        target="_blank" rel="noopener"
                        class="border-b border-teal pb-[2px] text-ink hover:text-interactive
                               transition-colors no-underline"
                    >
                        Yu-Chin Chan <span class="font-mono text-[9px] opacity-60 align-top" aria-hidden="true">↗</span>
                    </a>
                </span>
            </div>
        </div>
    </div>
    </section>
</div><!-- end mountain texture wrapper -->

<!-- ── § Recent Work ──────────────────────────────────────── -->
{recentProjects.length > 0 && (
    <section class="px-page pt-[48px] pb-[48px] border-t border-ink">
        <!-- Header -->
        <div class="flex items-baseline justify-between mb-[24px]">
            <h2
                class="font-display font-normal text-ink m-0"
                style="font-size: 44px; letter-spacing: -0.8px;"
            >
                <em>Recent</em> work.
            </h2>
            <span class="flex items-baseline gap-6">
                <span class="kicker">§ 01 / 05</span>
                <a
                    href="/projects"
                class="font-mono text-[10px] tracking-[0.2em] uppercase
                       border-b border-teal text-ink hover:text-interactive transition-colors no-underline"
            >
                See all →
            </a>
            </span>
        </div>

        <!-- 3-up cards -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-[28px]">
            {recentProjects.map(p => (
                <a
                    href={`/projects/${p.slug}`}
                    class="card-hover block no-underline text-ink"
                >
                    <!-- Category-keyed catalog plate (decorative) -->
                    <div
                        aria-hidden="true"
                        class="w-full relative overflow-hidden"
                        style={`height: 200px; background: rgb(var(${CATEGORY_TINT[p.category] ?? '--c-teal'}) / var(--swatch-alpha)); border: 1px solid var(--color-rule);`}
                    >
                        <span
                            class="font-display italic absolute inset-0 flex items-center justify-center"
                            style={`font-size: 96px; line-height: 1; color: rgb(var(${CATEGORY_TINT[p.category] ?? '--c-teal'}) / 1);`}
                        >
                            {p.title.charAt(0)}
                        </span>
                        <span
                            class="absolute top-[8px] right-[8px] font-mono text-[10px]"
                            style="color: var(--color-ink);"
                        >
                            {STATUS_SYMBOL[p.status] ?? '●'}
                        </span>
                    </div>
                    <div class="mt-[14px]">
                        <p class="kicker mb-[6px]">{p.date.slice(0,4)} · {p.category}</p>
                        <h3
                            class="font-display font-medium card-title m-0 mb-[8px] leading-[1]"
                            style="font-size: 28px; letter-spacing: -0.3px;"
                        >
                            {p.title}
                        </h3>
                        <p class="font-body text-[14px] leading-[1.55] opacity-80 m-0">
                            {p.summary}
                        </p>
                    </div>
                </a>
            ))}
        </div>
    </section>
)}

<!-- ── § Résumé (ledger) ──────────────────────────────────── -->
<section class="px-page pt-[48px] pb-[48px]">
    <div class="flex items-baseline justify-between mb-[24px]">
        <h2
            class="font-display font-normal text-ink m-0"
            style="font-size: 32px; letter-spacing: -0.4px;"
        >
            <em>A résumé,</em> compressed.
        </h2>
        <span class="kicker">§ 02 / 05</span>
    </div>

    <!-- Experience rows -->
    {experience.map(ex => {
        const [role, company] = ex.title.includes(' — ')
            ? ex.title.split(' — ')
            : [ex.title, ''];
        // Abbreviate long date ranges
        const dates = ex.dates.replace(/June/,'Jun').replace(/September/,'Sep');
        return (
            <div
                class="ledger-row"
                style="grid-template-columns: 56px 1fr;"
            >
                <span
                    class="font-mono text-[12px] tracking-[0.1em] opacity-70"
                    style="font-variant-numeric: tabular-nums;"
                >
                    {dates.match(/\d{4}/)?.[0] ?? ''}
                </span>
                <div>
                    <span
                        class={`font-display font-medium block leading-[1] ${ex.dates.includes('Present') ? 'text-tealDeep' : ''}`}
                        style="font-size: 18px; letter-spacing: -0.2px;"
                    >
                        {role}
                    </span>
                    {[company, dates].filter(Boolean).length > 0 && (
                        <span class="font-mono text-[10px] tracking-[0.1em] opacity-70 mt-[4px] block">
                            {[company, dates].filter(Boolean).join(' · ')}
                        </span>
                    )}
                </div>
            </div>
        );
    })}

    <!-- Education rows -->
    {education.map((e, i) => (
        <div
            class="ledger-row"
            style="grid-template-columns: 56px 1fr;"
        >
            <span
                class="font-mono text-[12px] tracking-[0.1em] opacity-70"
                style="font-variant-numeric: tabular-nums;"
            >
                {e.years.match(/\d{4}/)?.[0] ?? ''}
            </span>
            <div>
                <span
                    class="font-display font-medium block leading-[1]"
                    style="font-size: 18px; letter-spacing: -0.2px;"
                >
                    {e.degree}
                </span>
                <span class="font-mono text-[10px] tracking-[0.1em] opacity-70 mt-[4px] block">
                    {[e.school, e.years].filter(Boolean).join(' · ')}
                </span>
            </div>
        </div>
    ))}

</section>

<!-- ── § Publications (ledger) ─ rendered by Publications.astro ── -->
<slot name="publications" />

<!-- ── § Awards + Talks ───────────────────────────────────── -->
<section id="about-awards" class="px-page pt-[48px] pb-[48px]">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-[48px]">

        <!-- Awards -->
        <div>
            <div class="flex items-baseline justify-between mb-[24px]">
                <h2
                    class="font-display font-normal text-ink m-0"
                    style="font-size: 32px; letter-spacing: -0.4px;"
                >
                    <em>Honors,</em> awarded.
                </h2>
                <span class="kicker">§ 04 / 05</span>
            </div>
            {awards.slice(0, 2).map(a => <AwardRow a={a} />)}
            {awards.length > 2 && (
                <details class="ledger-more">
                    <summary>View all {awards.length} honors</summary>
                    <div class="pt-[6px]">
                        {awards.slice(2).map(a => <AwardRow a={a} />)}
                    </div>
                </details>
            )}
        </div>

        <!-- Talks -->
        <div>
            <div class="flex items-baseline justify-between mb-[24px]">
                <h2
                    class="font-display font-normal text-ink m-0"
                    style="font-size: 32px; letter-spacing: -0.4px;"
                >
                    <em>Talks,</em> given.
                </h2>
                <span class="kicker">§ 05 / 05</span>
            </div>
            {talks.map((t, i) => (
                <div
                    class="ledger-row"
                    style="grid-template-columns: 56px 1fr;"
                >
                    <span class="font-mono text-[12px] tracking-[0.1em] opacity-70"
                          style="font-variant-numeric: tabular-nums;">{t.date.slice(-4)}</span>
                    <div>
                        <span
                            class="font-display font-medium block leading-[1]"
                            style="font-size: 18px; letter-spacing: -0.2px;"
                        >{t.title}</span>
                        {t.venue && (
                            <span class="font-mono text-[10px] tracking-[0.1em] opacity-70 mt-[4px] block">
                                {t.venue}{t.location ? ` · ${t.location}` : ''}
                            </span>
                        )}
                    </div>
                </div>
            ))}
        </div>

    </div>
</section>

<script>
    // Assemble email from split data attributes — keeps the full address out of HTML source
    const emailEl = document.getElementById('contact-email') as HTMLAnchorElement | null;
    if (emailEl) {
        const addr = emailEl.dataset.u + '@' + emailEl.dataset.d;
        emailEl.href = 'mailto:' + addr;
        emailEl.textContent = addr;
    }

    // Scroll-driven bio fade: bio opacity tracks how much of portrait-wrap is in the viewport.
    // Fades out as the section scrolls up past the top; fades in when scrolling back down.
    const portraitWrap = document.getElementById('portrait-wrap');
    const bioEl = document.getElementById('bio-reveal');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (portraitWrap && bioEl && !reduceMotion) {
        function updateBioFade() {
            const rect = portraitWrap!.getBoundingClientRect();
            // Fade over a distance equal to 60% of the viewport height above the fold.
            const fadeDistance = window.innerHeight * 0.6;
            const opacity = rect.top >= 0 ? 1 : Math.max(0, 1 + rect.top / fadeDistance);
            bioEl!.style.opacity = opacity.toFixed(3);
        }
        window.addEventListener('scroll', updateBioFade, { passive: true });
        updateBioFade(); // set correct opacity on load
    }
</script>
